# ───────── App ─────────
APP_URL=http://localhost:3000              # public https URL in prod (used for OAuth redirects + webhooks)
SESSION_SECRET=                            # openssl rand -base64 48
ENCRYPTION_KEY=                            # openssl rand -base64 32  (encrypts Meta tokens at rest)

# ───────── Database (Supabase now, any Postgres later) ─────────
# Supabase → Project Settings → Database → Connection string
# Web app (serverless-friendly): transaction pooler :6543  → set DB_PREPARE=false
# Worker + migrations: session pooler :5432 (or direct)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rply
WORKER_DATABASE_URL=
DB_PREPARE=true
DB_POOL_MAX=10

# ───────── OpenAI ─────────
OPENAI_API_KEY=
AI_MODEL_FAST=gpt-6-luna                   # default replies (cheap)
AI_MODEL_SMART=gpt-6.1-terra               # complaints / long DMs
AI_EMBED_MODEL=text-embedding-3-small
AI_REASONING_EFFORT=                       # optional: minimal|low|medium (leave empty for non-reasoning models)
AI_CACHE_SIMILARITY=0.93                   # semantic cache threshold (cosine)
AI_STUFF_KNOWLEDGE_TOKENS=2500             # brain smaller than this → whole brain goes in the cached prefix (no RAG)

# ───────── Meta ─────────
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=                      # Facebook Login for Business → Configurations
META_WEBHOOK_VERIFY_TOKEN=                 # any random string, same one in App Dashboard → Webhooks
INSTAGRAM_APP_ID=                          # Instagram → API setup with Instagram login
INSTAGRAM_APP_SECRET=

# ───────── Worker ─────────
WORKER_CONCURRENCY=8
WORKER_POLL_MS=700
